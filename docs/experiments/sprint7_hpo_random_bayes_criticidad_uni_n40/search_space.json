      "low": 0.08,
      "high": 0.28
    },
    "w_uncertainty": {
      "type": "float",
      "low": 0.05,
      "high": 0.22
    },
    "w_rag_gap": {
      "type": "float",
      "low": 0.02,
      "high": 0.14
