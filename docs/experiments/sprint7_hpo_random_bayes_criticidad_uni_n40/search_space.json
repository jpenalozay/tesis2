    "pause_uncertainty": {
      "type": "float",
      "low": 0.36,
      "high": 0.58,
      "step": 0.02
    }
  },
  "constraints": [
    "threshold_pausa < threshold_stop",
    "weights normalizados a suma=1"
  ],
  "baseline_sprint6": {
    "mode": "stop_heavy",
    "threshold_stop": 0.54,
    "threshold_pausa": 0.24,
    "risk_stop_floor": 0.2,
